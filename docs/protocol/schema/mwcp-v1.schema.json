          "minimum": 0
        },
        "rx_crc_errors": {
          "type": "integer",
          "minimum": 0
        },
        "rx_oversize": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_requests": {
          "type": "integer",
          "minimum": 0
        },
        "radar_frames": {
          "type": "integer",
          "minimum": 0
        },
        "radar_errors": {
          "type": "integer",
          "minimum": 0
        },
        "telemetry_coalesced": {
          "type": "integer",
          "minimum": 0
        },
        "logs_dropped": {
          "type": "integer",
          "minimum": 0
        },
        "tx_overflow": {
