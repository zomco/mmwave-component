  "$defs": {
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "x-maxUtf8Bytes": 20
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "x-maxUtf8Bytes": 128
    },
    "quality": {
      "enum": [
        "valid",
        "unknown",
        "stale",
        "invalid",
        "unsupported"
      ]
    },
    "errorCode": {
      "enum": [
        "VERSION_UNSUPPORTED",
        "LIMIT_UNSUPPORTED",
        "UNSUPPORTED",
        "INVALID_ARGUMENT",
        "UNKNOWN_FIELD",
        "OUT_OF_RANGE",
        "PAYLOAD_TOO_LARGE",
        "ID_REUSE",
        "OP_ID_REUSE",
        "REQUEST_EXPIRED",
        "REVISION_CONFLICT",
        "BUSY",
        "RADAR_UNAVAILABLE",
        "RADAR_TIMEOUT",
        "VERIFY_FAILED",
        "STORAGE_FAILED",
        "RATE_LIMITED",
        "INTERNAL_ERROR"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 160
        },
        "field": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        },
        "details": {
          "type": "object",
          "maxProperties": 16
        }
      },
      "x-open-object": true
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "helloRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "nonce",
        "protocol",
        "max_payload"
      ],
      "properties": {
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "x-maxUtf8Bytes": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "x-maxUtf8Bytes": 32
            }
          }
        },
        "nonce": {
          "$ref": "#/$defs/hex32"
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor_max"
          ],
          "properties": {
            "major": {
              "const": 1
            },
            "minor_max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "max_payload": {
          "const": 4096
        }
      }
    },
    "helloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonce",
        "protocol",
        "boot_id",
        "session_ttl_ms",
        "limits",
        "identity",
        "cap_revision"
      ],
      "properties": {
        "nonce": {
          "$ref": "#/$defs/hex32"
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor"
          ],
          "properties": {
            "major": {
              "const": 1
            },
            "minor": {
              "const": 0
            }
          }
        },
        "boot_id": {
          "$ref": "#/$defs/hex32"
        },
        "session_ttl_ms": {
          "const": 15000
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_payload",
            "rpc_inflight",
            "max_targets",
            "event_budget_bps"
          ],
          "properties": {
            "max_payload": {
              "const": 4096
            },
            "rpc_inflight": {
              "const": 1
            },
            "max_targets": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "event_budget_bps": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 8000
            }
          }
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "cap_revision": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 64
        }
      },
      "x-open-object": true
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "configured_model",
        "dimension",
        "firmware_version"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 64
        },
        "configured_model": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 32
        },
        "dimension": {
          "enum": [
            "1D",
            "2D"
          ]
        },
        "firmware_version": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        }
      }
    },
    "deviceInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "boot_id",
        "configured_model",
        "dimension",
        "firmware_version",
        "git_sha",
        "release_channel",
        "build_profile",
        "host_protocol",
        "radar_identity"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        },
        "boot_id": {
          "$ref": "#/$defs/hex32"
        },
        "configured_model": {
          "type": "string",
          "x-maxUtf8Bytes": 32
        },
        "dimension": {
          "enum": [
            "1D",
            "2D"
          ]
        },
        "firmware_version": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        },
        "git_sha": {
          "type": [
            "string",
            "null"
          ],
          "x-maxUtf8Bytes": 40
        },
        "release_channel": {
          "enum": [
            "alpha",
            "beta",
            "development"
          ]
        },
        "build_profile": {
          "type": "string",
          "x-maxUtf8Bytes": 32
        },
        "host_protocol": {
          "const": "MWCP/1"
        },
        "radar_identity": {
          "type": [
            "string",
            "null"
          ],
          "x-maxUtf8Bytes": 64
        },
        "hardware_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "chip_flash_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "x-open-object": true
    },
    "pingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uptime_ms"
      ],
      "properties": {
        "uptime_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-open-object": true
    },
    "closedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed"
      ],
      "properties": {
        "closed": {
          "const": true
        }
      },
      "x-open-object": true
    },
    "cursorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      }
    },
    "capability": {
      "oneOf": [
        {
          "$ref": "#/$defs/featureCapability"
        },
        {
          "$ref": "#/$defs/configCapability"
        },
        {
          "$ref": "#/$defs/metricCapability"
        }
      ]
    },
    "featureCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "supported"
      ],
      "properties": {
        "kind": {
          "const": "feature"
        },
        "id": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        },
        "supported": {
          "type": "boolean"
        },
        "max_targets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "target_id_stable": {
          "type": "boolean"
        },
        "expected_interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stale_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "x-maxUtf8Bytes": 16
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "medical": {
          "const": false
        }
      }
    },
    "configCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "type",
        "writable",
        "domain",
        "restart_required"
      ],
      "properties": {
        "kind": {
          "const": "config"
        },
        "id": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        },
        "type": {
          "enum": [
            "number",
            "object",
            "null",
            "array"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "x-maxUtf8Bytes": 16
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "writable": {
          "type": "boolean"
        },
        "domain": {
          "enum": [
            "host"
          ]
        },
        "label_key": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        },
        "restart_required": {
          "type": "boolean"
        },
        "schema_id": {
          "type": "string",
          "x-maxUtf8Bytes": 64
        },
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "required": [
              "minimum",
              "maximum",
              "step",
              "unit"
            ]
          }
        }
      ]
    },
    "metricCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "supported",
        "unit"
      ],
      "properties": {
        "kind": {
          "const": "metric"
        },
        "id": {
          "type": "string"
        },
        "supported": {
          "type": "boolean"
        },
        "unit": {
          "type": "string"
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "expected_interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "medical": {
          "const": false
        }
      }
    },
    "capabilityPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "items",
        "next_cursor"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "x-maxUtf8Bytes": 64
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "x-open-object": true
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uptime_ms",
        "radar_link",
        "last_radar_frame_ms",
        "config_revision",
        "config_storage",
        "active_jobs",
        "counters"
      ],
      "properties": {
        "uptime_ms": {
          "type": "integer",
          "minimum": 0
        },
        "radar_link": {
          "enum": [
            "unknown",
            "waiting",
            "healthy",
            "stale",
            "error"
          ]
        },
        "last_radar_frame_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "config_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_storage": {
          "enum": [
            "healthy",
            "degraded",
            "recovery_required"
          ]
        },
        "active_jobs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "counters": {
          "$ref": "#/$defs/counters"
        },
        "reset_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "free_heap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
