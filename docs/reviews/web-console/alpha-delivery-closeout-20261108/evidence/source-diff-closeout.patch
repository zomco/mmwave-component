 def sha256(data: bytes) -> str:
     return hashlib.sha256(data).hexdigest()
 
 
+def collect_source_files(root: Path = ROOT) -> list[str]:
+    files = set()
+    for rel in EXPLICIT_SOURCE_FILES:
+        p = root / rel
