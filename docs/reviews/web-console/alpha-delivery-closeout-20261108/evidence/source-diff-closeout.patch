+def hash_source_files(rel_files: list[str], root: Path = ROOT) -> dict[str, str]:
+    res = {}
+    for rel in rel_files:
+        p = root / rel
+        if p.is_file():
+            res[rel] = sha256(p.read_bytes())
+        else:
+            res[rel] = "missing"
+    return res
+
