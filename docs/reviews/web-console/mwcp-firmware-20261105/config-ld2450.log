esphome:
  on_boot:
    - priority: -100.0
      then:
        - lambda: !lambda |-
            if (!id(g_area_1).empty()) id(text_area_1).publish_state(id(g_area_1));
            if (!id(g_area_2).empty()) id(text_area_2).publish_state(id(g_area_2));
            if (!id(g_area_3).empty()) id(text_area_3).publish_state(id(g_area_3));
        - script.execute:
            id: apply_area_1
        - script.execute:
            id: apply_area_2
        - script.execute:
            id: apply_area_3
        - lambda: !lambda |-
            id(radar).set_area_hysteresis(id(g_area_hysteresis));
            id(radar).set_area_still_speed(id(g_area_still_speed));
            id(radar).set_area_confirm_ms(static_cast<uint32_t>(id(g_area_confirm) * 1000.f + 0.5f));
            id(radar).set_area_clear_ms(static_cast<uint32_t>(id(g_area_clear) * 1000.f + 0.5f));
            id(radar).set_area_pass_speed(id(g_area_pass_speed));
        - lambda: !lambda |-
            // 开机启动后，将保存在闪存中的 globals 恢复给底层雷达组件
            id(radar).set_radar_x(id(g_radar_x));
            id(radar).set_radar_y(id(g_radar_y));
            id(radar).set_radar_z(id(g_radar_z));
            id(radar).set_yaw(id(g_yaw));
            id(radar).set_pitch(id(g_pitch));
            id(radar).set_roll(id(g_roll));

            if (!id(g_polygon).empty()) {
              id(text_polygon).publish_state(id(g_polygon));
            }
        - script.execute:
            id: apply_polygon
