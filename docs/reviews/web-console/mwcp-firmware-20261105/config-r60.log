script:
  - id: apply_area_1
    mode: restart
    then:
      - lambda: !lambda |-
          id(radar).clear_area(0);
          const std::string s = id(g_area_1);
          size_t start = 0;
          uint8_t added = 0;
          while (start <= s.size() && added < 12) {
            const size_t sep = s.find(';', start);
            const std::string pt = (sep == std::string::npos) ? s.substr(start) : s.substr(start, sep - start);
            start = (sep == std::string::npos) ? s.size() + 1 : sep + 1;
            if (pt.empty()) continue;
            const size_t comma = pt.find(',');
            if (comma == std::string::npos) continue;
            const std::string xs = pt.substr(0, comma);
            const std::string ys = pt.substr(comma + 1);
            char *xend = nullptr;
            char *yend = nullptr;
            const float px = strtof(xs.c_str(), &xend);
            const float py = strtof(ys.c_str(), &yend);
            if (xend == xs.c_str() || yend == ys.c_str() || !std::isfinite(px) || !std::isfinite(py)) continue;
            id(radar).add_area_point(0, px, py);
            added++;
          }
    parameters: {}
  - id: apply_area_2
    mode: restart
    then:
      - lambda: !lambda |-
          id(radar).clear_area(1);
          const std::string s = id(g_area_2);
          size_t start = 0;
          uint8_t added = 0;
          while (start <= s.size() && added < 12) {
            const size_t sep = s.find(';', start);
            const std::string pt = (sep == std::string::npos) ? s.substr(start) : s.substr(start, sep - start);
            start = (sep == std::string::npos) ? s.size() + 1 : sep + 1;
            if (pt.empty()) continue;
            const size_t comma = pt.find(',');
            if (comma == std::string::npos) continue;
            const std::string xs = pt.substr(0, comma);
            const std::string ys = pt.substr(comma + 1);
            char *xend = nullptr;
            char *yend = nullptr;
            const float px = strtof(xs.c_str(), &xend);
            const float py = strtof(ys.c_str(), &yend);
            if (xend == xs.c_str() || yend == ys.c_str() || !std::isfinite(px) || !std::isfinite(py)) continue;
            id(radar).add_area_point(1, px, py);
            added++;
          }
    parameters: {}
  - id: apply_area_3
    mode: restart
    then:
      - lambda: !lambda |-
          id(radar).clear_area(2);
          const std::string s = id(g_area_3);
          size_t start = 0;
          uint8_t added = 0;
          while (start <= s.size() && added < 12) {
            const size_t sep = s.find(';', start);
            const std::string pt = (sep == std::string::npos) ? s.substr(start) : s.substr(start, sep - start);
            start = (sep == std::string::npos) ? s.size() + 1 : sep + 1;
            if (pt.empty()) continue;
            const size_t comma = pt.find(',');
            if (comma == std::string::npos) continue;
            const std::string xs = pt.substr(0, comma);
            const std::string ys = pt.substr(comma + 1);
            char *xend = nullptr;
            char *yend = nullptr;
            const float px = strtof(xs.c_str(), &xend);
            const float py = strtof(ys.c_str(), &yend);
            if (xend == xs.c_str() || yend == ys.c_str() || !std::isfinite(px) || !std::isfinite(py)) continue;
            id(radar).add_area_point(2, px, py);
            added++;
          }
    parameters: {}
  - id: apply_polygon
    mode: restart
    then:
      - lambda: !lambda |-
          // 瑙ｆ瀽 "x1,y1;x2,y2;..." 褰㈠紡鐨勫杈瑰舰瀛楃涓层€?
          //
          // 杩欓噷缁濅笉鑳界敤 std::stof銆侲SPHome 鐨?esp-idf 鏋勫缓鍏抽棴浜?C++ 寮傚父
          // (sdkconfig: CONFIG_COMPILER_CXX_EXCEPTIONS is not set)锛宻td::stof
          // 閬囧埌闈炴硶杈撳叆浼?std::terminate() -> abort()锛屼篃灏辨槸鐢ㄦ埛鍦?HA 鐨?
          // 鏂囨湰妗嗛噷闅忔墜鎵撻敊涓€涓瓧绗﹀氨浼氭妸闆疯揪閲嶅惎銆?
          //
          // 鏀圭敤 strtof + endptr 鏍￠獙锛氶潪娉曠殑鐐硅烦杩囧苟鍛婅锛屽叾浣欑収甯稿簲鐢ㄣ€?
          id(radar).clear_polygon();
          const std::string s = id(g_polygon);
          size_t start = 0;
          uint8_t added = 0;
          uint8_t rejected = 0;
          // 涓婇檺鍚屾椂闃蹭綇瓒呴暱杈撳叆鎾戠垎鍐呭瓨銆?
          while (start <= s.size() && added < 64) {
            const size_t sep = s.find(';', start);
            const std::string pt =
                (sep == std::string::npos) ? s.substr(start) : s.substr(start, sep - start);
            start = (sep == std::string::npos) ? s.size() + 1 : sep + 1;
            if (pt.empty()) continue;

            const size_t comma = pt.find(',');
            if (comma == std::string::npos) { rejected++; continue; }

            const std::string xs = pt.substr(0, comma);
            const std::string ys = pt.substr(comma + 1);
            char *xend = nullptr;
            char *yend = nullptr;
            const float px = strtof(xs.c_str(), &xend);
            const float py = strtof(ys.c_str(), &yend);
            // endptr 鏈墠杩?= 瀹屽叏娌¤В鏋愬嚭鏁板瓧锛涘啀鎸℃帀 inf/nan銆?
            if (xend == xs.c_str() || yend == ys.c_str() ||
                !std::isfinite(px) || !std::isfinite(py)) {
              rejected++;
              continue;
            }

            id(radar).add_polygon_point(px, py);
            added++;
          }
          if (rejected > 0)
            ESP_LOGW("polygon", "Ignored %u malformed point(s) in polygon string", rejected);
          ESP_LOGI("polygon", "Applied %u polygon point(s)", added);
    parameters: {}
