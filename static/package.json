{
  "name": "mmwave-web-installer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node script/apply-installer-download-guard.mjs && vite build",
    "preview": "vite preview",
    "test": "node script/apply-installer-download-guard.mjs && node --experimental-vm-modules --test --test-timeout=120000 test/*.test.js test/browser/*.test.js",
    "test:unit": "node script/apply-installer-download-guard.mjs && node --experimental-vm-modules --test --test-timeout=60000 test/*.test.js",
    "test:browser": "node script/apply-installer-download-guard.mjs && node --test --test-timeout=90000 test/browser/*.test.js"
  },
  "dependencies": {
    "esp-web-tools": "^10.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
