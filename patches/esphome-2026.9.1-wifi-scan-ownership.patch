+#pragma once
+
+#include <cstdint>
+
+namespace esphome {
+namespace wifi {
+
+/// Who owns the radio for the one scan that may be outstanding.
+enum class ScanOwner : uint8_t { kNone, kBackground, kComponent };
+
+/// Why a coordinated start did not begin a driver scan.
+enum class ScanDriverResult : uint8_t {
+  kStarted,  ///< the driver accepted the scan
+  kBusy,     ///< another scan owns the radio; the driver was not called
+  kRefused,  ///< the driver rejected the start
+};
+
+/// Ownership kind requested at the driver choke point.
+enum class ScanOrigin : uint8_t { kBackground, kComponent };
+
+/// One start request handed to the driver choke point.
+///
+/// A background request reserves the radio itself. A component request carries
+/// the generation returned by ScanOwnership::begin(); the choke point verifies
+/// that generation is still the outstanding component reservation before the
+/// driver is called, so no scan can start without the reservation that makes
+/// its SCAN_DONE event attributable.
+struct ScanTicket {
+  ScanOrigin origin{ScanOrigin::kBackground};
+  uint32_t generation{0};
+};
+
+/// The one driver callback the coordinator is allowed to invoke.
+struct ScanDriver {
+  bool (*start)(void *user, bool passive);
+  void *user;
+};
+
+/// Exclusive ownership bookkeeping for the single scan the WiFi component may
+/// have outstanding.
+///
+/// Neither the ESP-IDF driver nor ESPHome tags a SCAN_DONE event with the
+/// request that produced it. A completion can only be attributed safely while
+/// at most one scan, background or component-owned, is outstanding. Every
+/// start therefore reserves this gate at the driver choke point
+/// (start_owned_scan below), and only a component start carries a generation.
+/// An event consumes the in-flight reservation: a component event is delivered
+/// with its generation, a background event is dropped.
+///
+/// There is deliberately no time-based release. A late completion still
+/// belongs to the in-flight scan; releasing solely because a timeout, cooldown,
+/// reconnect or enable/disable transition elapsed would let the next request
+/// inherit that completion and publish the earlier scan's access points. If the
+/// completion is lost, the gate stays closed and later starts are refused:
+/// failing closed is the only option that cannot mistake another scan's results
+/// for this request's.
+class ScanOwnership {
+ public:
+  ScanOwnership() = default;
+  /// Test seam for generation wrap-around; production uses the default.
+  explicit ScanOwnership(uint32_t last_generation) : last_generation_(last_generation) {}
+
+  /// Reserve the radio for a component-owned scan and write its generation.
+  /// Returns false while any earlier scan has not reported completion.
+  bool begin(uint32_t *generation) {
+    if (generation == nullptr || this->in_flight_)
+      return false;
+    this->last_generation_++;
+    if (this->last_generation_ == 0)
+      this->last_generation_ = 1;
+    this->pending_generation_ = this->last_generation_;
+    this->pending_ = true;
+    this->in_flight_ = true;
+    *generation = this->pending_generation_;
+    return true;
+  }
+
+  /// Reserve the radio for a background scan. Returns false while any earlier
+  /// scan, component-owned or background, has not reported completion.
+  bool begin_background() {
+    if (this->in_flight_)
+      return false;
+    this->pending_ = false;
+    this->pending_generation_ = 0;
+    this->in_flight_ = true;
+    return true;
+  }
+
+  /// Whether `generation` is the outstanding component reservation. A
+  /// background scan has no generation, so it can never authorize a component
+  /// start.
+  bool owns(uint32_t generation) const {
+    return this->in_flight_ && this->pending_ && generation != 0 && generation == this->pending_generation_;
+  }
+
+  /// Consume the in-flight scan. Returns kComponent and writes the generation
+  /// only when this event belongs to a component request; a background event
+  /// returns kBackground, and an event with no reservation returns kNone.
+  /// Both of the latter still reopen the gate if it was held.
+  ScanOwner take(uint32_t *generation) {
+    if (!this->in_flight_)
+      return ScanOwner::kNone;
+    const bool component = this->pending_;
+    this->in_flight_ = false;
+    if (!component)
+      return ScanOwner::kBackground;
+    if (generation != nullptr)
+      *generation = this->pending_generation_;
+    this->pending_ = false;
+    this->pending_generation_ = 0;
+    return ScanOwner::kComponent;
+  }
+
+  /// Drop a component request whose driver start was refused, so no completion
+  /// event will be emitted. The generation check rejects a stale cancel.
+  bool cancel(uint32_t generation) {
+    if (!this->pending_ || !this->in_flight_ || generation == 0 || generation != this->pending_generation_)
+      return false;
+    this->pending_ = false;
+    this->pending_generation_ = 0;
+    this->in_flight_ = false;
+    return true;
+  }
+
+  /// Drop a background reservation whose driver start was refused.
+  void cancel_background() {
+    if (!this->in_flight_ || this->pending_)
+      return;
+    this->in_flight_ = false;
+  }
+
+  bool pending() const { return this->pending_; }
+  bool in_flight() const { return this->in_flight_; }
+  ScanOwner owner() const {
+    if (!this->in_flight_)
+      return ScanOwner::kNone;
+    return this->pending_ ? ScanOwner::kComponent : ScanOwner::kBackground;
+  }
+
+ private:
+  uint32_t last_generation_{0};
+  uint32_t pending_generation_{0};
+  bool pending_{false};
+  bool in_flight_{false};
+};
+
+/// Single choke point for every driver scan start.
+///
+/// Every platform's wifi_scan_start_platform_() is reached only through this
+/// function (checked by scripts/check_scan_ownership_sources.py). The
+/// reservation is created or verified before the driver is called, so an
+/// accepted scan always has exactly one owner for its SCAN_DONE event:
+///
+///  - background: reserve here, refuse while any scan is outstanding, and
+///    release only if the driver rejects the start;
+///  - component: require the caller's generation to be the outstanding
+///    component reservation, so a background or stale ticket cannot start a
+///    second scan.
+///
+/// A driver refusal leaves a component reservation in place; the component
+/// path cancels it by generation. There is no timeout or state-machine hook
+/// that releases ownership.
+inline ScanDriverResult start_owned_scan(ScanOwnership &gate, const ScanDriver &driver, const ScanTicket &ticket,
+                                         bool passive) {
+  if (driver.start == nullptr)
+    return ScanDriverResult::kRefused;
+
+  const bool component = ticket.origin == ScanOrigin::kComponent;
+  if (component) {
+    if (!gate.owns(ticket.generation))
+      return ScanDriverResult::kBusy;
+  } else if (!gate.begin_background()) {
+    return ScanDriverResult::kBusy;
+  }
+
+  if (!driver.start(driver.user, passive)) {
+    // The driver did not accept the scan, so no completion event will follow.
+    // A component reservation is cancelled by its owner so the cancel can be
+    // generation-checked; a background one is released here.
+    if (!component)
+      gate.cancel_background();
+    return ScanDriverResult::kRefused;
+  }
+  return ScanDriverResult::kStarted;
+}
+
+/// Host hooks the coordinator needs from the WiFi component.
+struct ScanHost {
+  /// True when a component scan may start now: Wi-Fi enabled, not associating,
+  /// not scanning and not roaming. Never consulted for background scans, which
+  /// the WiFi state machine schedules itself.
+  bool (*component_allowed)(void *user);
+  /// Start the platform driver scan. Only called with a reservation in place.
+  bool (*start_driver)(void *user, bool passive);
+  void *user;
+};
+
+/// Outcome of a coordinated start.
+enum class ScanStartResult : uint8_t {
+  kStarted,
+  kBusy,           ///< an earlier scan still owns the radio; driver untouched
+  kRefused,        ///< a precondition failed; driver untouched
+  kDriverRefused,  ///< the driver rejected the start
+};
+
+/// The one scan lifecycle every WiFi scan entry shares.
+///
+/// Connection, retry and roaming scans call start_background(); a component
+/// request calls start_component(). Both reserve the same gate before the
+/// driver is touched, so a completion can be classified as background or
+/// component without relying on timing or on the public WiFi state machine.
+/// The WiFi state machine may leave STA_SCANNING, enter cooldown, reconnect or
+/// be disabled while a scan is still outstanding; none of those transitions
+/// touches this coordinator.
+class ScanCoordinator {
+ public:
+  ScanCoordinator() = default;
+  /// Test seam for generation wrap-around; production uses the default.
+  explicit ScanCoordinator(uint32_t last_generation) : gate_(last_generation) {}
+
+  /// Reserve the radio for a background (connection, retry or roaming) scan
+  /// and start it. Returns kStarted only if the driver accepted.
+  ScanStartResult start_background(const ScanHost &host, bool passive) {
+    const ScanDriverResult result =
+        start_owned_scan(this->gate_, ScanDriver{host.start_driver, host.user}, ScanTicket{}, passive);
+    if (result == ScanDriverResult::kStarted) {
+      this->starts_++;
+      return ScanStartResult::kStarted;
+    }
+    return result == ScanDriverResult::kBusy ? ScanStartResult::kBusy : ScanStartResult::kDriverRefused;
+  }
+
+  /// Reserve the radio for one component-owned scan and start it.
+  ///
+  /// Returns kRefused without touching the driver when the host precondition
+  /// fails, kBusy while any earlier scan is outstanding, and kDriverRefused
+  /// when the driver rejects the start (the reservation is cancelled so the
+  /// next request is not stranded). On kStarted the caller receives a non-zero
+  /// generation that the completion dispatch returns only for this scan.
+  ScanStartResult start_component(const ScanHost &host, bool passive, uint32_t *generation) {
+    if (generation == nullptr || host.component_allowed == nullptr || host.start_driver == nullptr)
+      return ScanStartResult::kRefused;
+    if (!host.component_allowed(host.user))
+      return ScanStartResult::kRefused;
+
+    uint32_t component_generation = 0;
+    if (!this->gate_.begin(&component_generation))
+      return ScanStartResult::kBusy;
+
+    const ScanTicket ticket{ScanOrigin::kComponent, component_generation};
+    const ScanDriverResult result =
+        start_owned_scan(this->gate_, ScanDriver{host.start_driver, host.user}, ticket, passive);
+    if (result != ScanDriverResult::kStarted) {
+      this->gate_.cancel(component_generation);
+      return result == ScanDriverResult::kBusy ? ScanStartResult::kBusy : ScanStartResult::kDriverRefused;
+    }
+    this->starts_++;
+    *generation = component_generation;
+    return ScanStartResult::kStarted;
+  }
+
+  /// Classify and consume one SCAN_DONE event. kComponent is the only result
+  /// that may reach a component listener; a background or unmatched event must
+  /// never be attributed to the outstanding component request.
+  ScanOwner take_completion(uint32_t *generation) {
+    this->completions_++;
+    const ScanOwner owner = this->gate_.take(generation);
+    if (owner == ScanOwner::kNone)
+      this->stray_completions_++;
+    return owner;
+  }
+
+  bool in_flight() const { return this->gate_.in_flight(); }
+  bool component_pending() const { return this->gate_.pending(); }
+  uint32_t starts() const { return this->starts_; }
+  uint32_t completions() const { return this->completions_; }
+  uint32_t stray_completions() const { return this->stray_completions_; }
+
+ private:
+  ScanOwnership gate_;
+  uint32_t starts_{0};
+  uint32_t completions_{0};
+  uint32_t stray_completions_{0};
+};
